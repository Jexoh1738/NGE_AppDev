@page "/test"
@inject NavigationManager NavManager

<div class="relative w-screen h-screen m-0 box-border overflow-hidden flex flex-col items-center justify-center bg-[#0d0614]
            bg-[radial-gradient(ellipse_1200px_700px_at_50%_32%,rgba(74,36,112,0.55),transparent_60%),radial-gradient(ellipse_900px_500px_at_50%_100%,rgba(242,169,59,0.10),transparent_60%)]">

    <div class="scanlines pointer-events-none absolute inset-0 z-[1]"></div>

    <div class="pointer-events-none fixed top-0 left-0 z-[2] w-[clamp(90px,14vw,150px)] h-[clamp(90px,14vw,150px)]">
        <svg viewBox="0 0 150 150" xmlns="http://www.w3.org/2000/svg" class="w-full h-full block">
            <polygon points="0,0 150,0 0,150" fill="#8fd13f" opacity="0.9" />
            <polygon points="0,0 95,0 0,95" fill="#f2a93b" opacity="0.55" />
            <polygon points="0,0 55,0 0,55" fill="#4a2470" opacity="0.85" />
        </svg>
    </div>
    <div class="pointer-events-none fixed top-0 right-0 z-[2] w-[clamp(90px,14vw,150px)] h-[clamp(90px,14vw,150px)] -scale-x-100">
        <svg viewBox="0 0 150 150" xmlns="http://www.w3.org/2000/svg" class="w-full h-full block">
            <polygon points="0,0 150,0 0,150" fill="#8fd13f" opacity="0.9" />
            <polygon points="0,0 95,0 0,95" fill="#f2a93b" opacity="0.55" />
            <polygon points="0,0 55,0 0,55" fill="#4a2470" opacity="0.85" />
        </svg>
    </div>

    <div class="panel-brackets relative z-[3] w-full max-w-[420px] py-10 px-8 mx-6 text-center
                bg-gradient-to-b from-[#2a1240]/[0.92] to-[#0d0614]/[0.94]
                border border-[#8fd13f]/35
                shadow-[0_0_0_1px_rgba(242,169,59,0.12),0_24px_60px_rgba(0,0,0,0.55)]">

        <p class="[font-family:'JetBrains_Mono',monospace] text-[11px] tracking-[0.22em] text-[#8fd13f] mb-2
                  drop-shadow-[0_0_8px_rgba(143,209,63,0.5)]">
            SYNCHRONIZATION COMPLETE
        </p>
        <h1 class="[font-family:'Rajdhani',sans-serif] font-bold text-2xl text-[#ece5f2] mb-4">
            Unit Entry Confirmed
        </h1>
        <p class="[font-family:'JetBrains_Mono',monospace] text-[13px] leading-relaxed text-[#c9a8e8] mb-8">
            This is a placeholder screen — it only confirms the "Enter Unit" button and
            navigation are wired correctly. No credentials were actually verified.
        </p>

        <div class="flex gap-2.5 justify-center">
            <button type="button"
                    class="py-2.5 px-6 [font-family:'Rajdhani',sans-serif] font-bold text-sm cursor-pointer
                           bg-gradient-to-b from-[#8fd13f] to-[#4c7a1f] text-[#10240a]
                           [clip-path:polygon(10px_0,100%_0,100%_calc(100%-10px),calc(100%-10px)_100%,0_100%,0_10px)]
                           hover:brightness-110"
                    @onclick="OpenComments">
                Comment Board
            </button>
            <button type="button"
                    class="py-2.5 px-6 [font-family:'Rajdhani',sans-serif] font-bold text-sm cursor-pointer
                           bg-transparent border border-[#f2a93b] text-[#f2a93b]
                           [clip-path:polygon(10px_0,100%_0,100%_calc(100%-10px),calc(100%-10px)_100%,0_100%,0_10px)]
                           hover:brightness-110"
                    @onclick="GoBack">
                Return to Login
            </button>
        </div>
    </div>
</div>

@code {
    private void GoBack()
    {
        NavManager.NavigateTo("/login");
    }

    private void OpenComments()
    {
        NavManager.NavigateTo("/comments");
    }
}
